    {
      "parameters": {
        "jsCode": "const normalize = (v) => (v || '').toString().trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst rows = $input.all().map(i => i.json);\n\nconst pending = rows.filter(r => {\n  const email = (r.email || r['e-mail'] || '').toString().trim();\n  const valeur = normalize(r.valeur);\n  return email && (valeur === 'a envoyer' || valeur === 'a_envoyer');\n});\n\nif (!pending.length) return [];\nconst first = pending[0];\n\nconst email = (first.email || first['e-mail'] || '').toString().trim();\n\n// Lien de tracking unique par contact\n// Format: https://n8n.zionworld.fr/webhook/track-clic?email=ENCODED_EMAIL\nconst trackingUrl = 'https://n8n.zionworld.fr/webhook/track-clic?email=' + encodeURIComponent(email);\n\nreturn [{\n  json: {\n    email: email,\n    valeur: first.valeur || '',\n    statuts: first.statuts || '',\n    dernier_resultat: first.dernier_resultat || '',\n    erreur: first.erreur || '',\n    clic: first.clic || '',\n    date_envoi_iso: new Date().toISOString(),\n    tracking_url: trackingUrl\n  }\n}];"
      },
      "id": "n3",
      "name": "Selection 1 contact + tracking URL",
      "type": "n8n-nodes-base.code",
