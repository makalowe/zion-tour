    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst normalize = (v) => (v || '').toString().trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n\nconst pending = rows.filter(r => {\n  const email = (r.email || r['e-mail'] || '').toString().trim();\n  const statut = normalize(r.statut);\n  return email && statut !== 'envoye';\n});\n\nif (!pending.length) return [];\n\nconst first = pending[0];\nreturn [{\n  json: {\n    email: (first.email || first['e-mail'] || '').toString().trim(),\n    statut: first.statut || '',\n    clic: first.clic || ''\n  }\n}];"
      },
